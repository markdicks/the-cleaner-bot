<%- include('partials/head', { title }) %>
<%- include('partials/connection', { compact: true }) %>
<section class="page-heading module-heading"><div><a class="server-context" href="<%= serverUrl(guild.guildId) %>"><%= guild.guildName %></a><h1><%= title %></h1></div><div class="button-row"><% if (tab === 'logs') { %><a class="button secondary" href="<%= serverUrl(guild.guildId, 'activity') %>"><i data-lucide="list-filter"></i>View activity</a><% } else if (tab === 'actions') { %><a class="button secondary" href="<%= serverUrl(guild.guildId, 'cases') %>"><i data-lucide="contact-round"></i>Punishment history</a><% } %><span class="badge"><%= guild.premiumTier %></span></div></section>
<% if (views.length) { %><%- include('partials/subnav') %><% } %>
<% if (tab === 'overview') { %><%- include('partials/overview') %>
<% } else if (tab === 'automod') { %><%- include('partials/automod') %>
<% } else if (tab === 'actions') { %><%- include('partials/moderation-actions') %>
<% } else if (tab === 'cases') { %><%- include('partials/case-history') %>
<% } else if (tab === 'logs') { if (view === 'checks') { %><%- include('partials/log-diagnostics') %><% } else { %><%- include('partials/log-settings') %><% } %>
<% } else if (tab === 'cleaner') { %><%- include('partials/cleaner') %>
<% } else { %><%- include('partials/community-settings') %><% } %>
<%- include('partials/foot') %>
