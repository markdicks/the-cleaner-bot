<%- include('partials/head', { title: guild.guildName }) %>
<section class="page-heading"><div><a class="back-link" href="/Dashboard">Servers</a><h1><%= guild.guildName %></h1><p class="mono muted"><%= guild.guildId %></p></div><span class="badge"><%= guild.premiumTier %></span></section>
<nav class="tabs" aria-label="Server settings"><% for (const [key, label, icon] of [['overview','Overview','layout-dashboard'],['moderation','Moderation','shield'],['channels','Channels & levels','hash'],['cleaner','Cleaner','brush'],['cases','Cases & actions','gavel'],['logs','Audit logs','scroll-text'],['levels','Leaderboard','trophy']]) { %><a class="<%= tab === key ? 'selected' : '' %>" href="/Dashboard/Guild/<%= guild.guildId %>?tab=<%= key %>" <%- tab === key ? 'aria-current="page"' : '' %>><i data-lucide="<%= icon %>"></i><%= label %></a><% } %></nav>
<% if (tab === 'overview') { %>
<div class="metrics"><div><span>Moderation</span><strong><%= guild.enableModeration ? 'Enabled' : 'Disabled' %></strong></div><div><span>Blocked words</span><strong><%= guild.blockedWords.length %></strong></div><div><span>Cleaning targets</span><strong><%= guild.cleaner.botList.length %></strong></div><div><span>XP & levels</span><strong><%= guild.enableLevels ? 'Enabled' : 'Disabled' %></strong></div></div>
<section class="section"><div class="section-heading"><h2>Server configuration</h2></div><dl class="status-list"><div><dt>Prefix</dt><dd><code><%= guild.prefix %></code></dd></div><div><dt>Message filters</dt><dd class="<%= contentAccess ? 'text-success' : 'text-warning' %>"><%= contentAccess ? 'Message content available' : 'Privileged intents required' %></dd></div><div><dt>Cleaning interval</dt><dd><%= guild.cleaner.intervalMinutes %> minutes</dd></div><div><dt>Voice XP</dt><dd><%= guild.enableVoiceXp ? 'Enabled' : 'Disabled' %></dd></div><div><dt>Last updated</dt><dd><%= new Date(guild.updatedAt).toLocaleString('en-GB', { timeZone: 'UTC' }) %> UTC</dd></div></dl></section>
<section class="section"><div class="section-heading"><h2>Recent cases</h2><a href="?tab=cases">View all</a></div><%- include('partials/cases', { cases: cases.slice(0, 8) }) %></section>
<% } else if (tab === 'moderation') { %>
<form method="post" class="settings-form"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="section" value="moderation">
<section class="section"><div class="section-heading"><h2>Automatic moderation</h2></div><div class="toggle-grid"><% for (const [key, label] of [['enableModeration','Moderation enabled'],['enableAntiSpam','Spam & image flood'],['enableProfanityFilter','Blocked words'],['enableInviteFilter','Discord invites'],['enableLinkFilter','External links'],['enableCapsFilter','Excessive capitals'],['enableMentionFilter','Mention spam'],['enableDmModerationNotices','Private moderation notices']]) { %><label class="toggle-row"><span><%= label %></span><input class="switch" type="checkbox" name="<%= key %>" <%= guild[key] ? 'checked' : '' %>></label><% } %></div></section>
<section class="section"><div class="section-heading"><h2>Thresholds</h2></div><div class="field-grid"><% for (const [key, label, min, max] of [['spamWindowSeconds','Spam window (seconds)',2,120],['spamMessageLimit','Messages per window',2,50],['mentionLimit','Mention limit',2,50],['capsMinimumLength','Minimum letters for caps',5,2000],['capsPercentage','Capitals threshold (%)',25,100],['maxWarningsBeforeTimeout','Warnings before timeout',1,100],['timeoutMinutes','Timeout (minutes)',1,40320]]) { %><label class="field"><span><%= label %></span><input type="number" name="<%= key %>" value="<%= guild[key] %>" min="<%= min %>" max="<%= max %>" required></label><% } %></div></section>
<section class="section"><div class="section-heading"><h2>Blocked words</h2><span class="muted"><%= guild.blockedWords.length %> entries</span></div><textarea name="blockedWords" rows="8" aria-label="Blocked words" placeholder="One word or phrase per line"><%= guild.blockedWords.join('\n') %></textarea></section><div class="form-actions"><button class="button primary"><i data-lucide="save"></i>Save moderation settings</button></div></form>
<% } else if (tab === 'channels') { %>
<form method="post" class="settings-form"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="section" value="channels">
<section class="section"><div class="section-heading"><h2>Channels & levels</h2></div><div class="field-grid"><label class="field"><span>Command prefix</span><input name="prefix" value="<%= guild.prefix %>" maxlength="10" required></label><% for (const [key, label] of [['levelsChannelId','Level announcements'],['logChannelId','Fallback moderation log'],['welcomeChannelId','Welcome & goodbye']]) { %><label class="field"><span><%= label %></span><select name="<%= key %>"><option value="">None</option><% channels.forEach(channel => { %><option value="<%= channel.id %>" <%= guild[key] === channel.id ? 'selected' : '' %>>#<%= channel.name %></option><% }); %></select></label><% } %></div><div class="toggle-grid"><% for (const [key, label] of [['enableLevels','Chat XP & levels'],['enableVoiceXp','Voice XP'],['enableWelcome','Welcome & goodbye messages']]) { %><label class="toggle-row"><span><%= label %></span><input class="switch" type="checkbox" name="<%= key %>" <%= guild[key] ? 'checked' : '' %>></label><% } %></div></section>
<section class="section"><div class="section-heading"><h2>Ignored moderation channels</h2></div><div class="checkbox-grid"><% channels.forEach(channel => { %><label class="check"><input type="checkbox" name="ignoredModerationChannelIds" value="<%= channel.id %>" <%= guild.ignoredModerationChannelIds.includes(channel.id) ? 'checked' : '' %>>#<%= channel.name %></label><% }); %><% if (!channels.length) { %><p class="muted">Channels are unavailable while the bot is offline.</p><% } %></div></section>
<section class="section"><div class="section-heading"><h2>Member messages</h2></div><div class="field-grid"><label class="field"><span>Welcome message</span><textarea name="welcomeMessage" rows="3" maxlength="1900"><%= guild.welcomeMessage %></textarea></label><label class="field"><span>Goodbye message</span><textarea name="goodbyeMessage" rows="3" maxlength="1900"><%= guild.goodbyeMessage %></textarea></label></div></section><div class="form-actions"><button class="button primary"><i data-lucide="save"></i>Save channel settings</button></div></form>
<% } else if (tab === 'cleaner') { %>
<form method="post" class="settings-form"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="section" value="cleaner"><section class="section"><div class="section-heading"><h2>Bot-message cleaning</h2></div><div class="field-grid"><label class="field"><span>Interval (minutes)</span><input type="number" name="intervalMinutes" min="1" max="120960" value="<%= guild.cleaner.intervalMinutes %>" required></label><label class="field"><span>Cleaning log channel</span><select name="cleanerLogChannelId"><option value="">None</option><% channels.forEach(channel => { %><option value="<%= channel.id %>" <%= guild.cleaner.logChannelId === channel.id ? 'selected' : '' %>>#<%= channel.name %></option><% }); %></select></label></div></section>
<section class="section"><div class="section-heading"><h2>Monitored channels</h2></div><div class="checkbox-grid"><% channels.forEach(channel => { %><label class="check"><input type="checkbox" name="monitorChannels" value="<%= channel.id %>" <%= guild.cleaner.monitorChannels.includes(channel.id) ? 'checked' : '' %>>#<%= channel.name %></label><% }); %></div></section><section class="section"><div class="section-heading"><h2>Cleaning targets</h2></div><label class="field"><span>Bot ID and remaining rounds</span><textarea name="botList" rows="8" placeholder="123456789012345678 -1"><%= guild.cleaner.botList.map(bot => `${bot.botId} ${bot.rounds}`).join('\n') %></textarea></label></section><div class="form-actions"><button class="button primary"><i data-lucide="save"></i>Save cleaning settings</button></div></form>
<% } else if (tab === 'cases') { %>
<section class="section"><div class="section-heading"><h2>Member action</h2></div><form method="post" action="/Dashboard/Guild/<%= guild.guildId %>/action"><input type="hidden" name="csrf" value="<%= csrf %>"><div class="field-grid"><label class="field"><span>Action</span><select name="action"><option value="warn">Warning</option><option value="timeout">Timeout / mute</option><option value="untimeout">Remove timeout</option><option value="kick">Kick</option><option value="ban">Ban</option><option value="unban">Unban</option></select></label><label class="field"><span>Discord user ID</span><input name="userId" inputmode="numeric" pattern="[0-9]{17,20}" required></label><label class="field"><span>Timeout duration (minutes)</span><input type="number" name="minutes" min="1" max="40320" value="<%= guild.timeoutMinutes %>"></label><label class="field"><span>Reason</span><input name="reason" maxlength="500" required></label></div><div class="form-actions"><label class="check"><input type="checkbox" name="confirm" required>Confirm member action</label><button class="button danger"><i data-lucide="gavel"></i>Apply action</button></div></form></section>
<section class="section"><div class="section-heading"><h2>Purge messages</h2></div><form method="post" action="/Dashboard/Guild/<%= guild.guildId %>/action"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="action" value="purge"><div class="field-grid"><label class="field"><span>Channel</span><select name="channelId" required><% channels.forEach(channel => { %><option value="<%= channel.id %>">#<%= channel.name %></option><% }); %></select></label><label class="field"><span>Messages to inspect</span><input type="number" name="count" min="1" max="1000" value="100" required></label><label class="field"><span>Only user ID (optional)</span><input name="userId" inputmode="numeric" pattern="[0-9]{17,20}"></label><label class="field"><span>Only role ID (optional)</span><input name="roleId" inputmode="numeric" pattern="[0-9]{17,20}"></label><label class="field"><span>Text contains (optional)</span><input name="contains" maxlength="200"></label><label class="check"><input type="checkbox" name="bots">Only bot messages</label></div><div class="form-actions"><label class="check"><input type="checkbox" name="confirm" required>Confirm message deletion</label><button class="button danger"><i data-lucide="trash-2"></i>Purge matching messages</button></div></form></section><section class="section"><div class="section-heading"><h2>Case history</h2><span class="muted">Latest 100</span></div><%- include('partials/cases', { cases }) %></section>
<% } else if (tab === 'logs') { %>
<section class="section"><div class="section-heading"><h2>Audit logging</h2><% if (business) { %><a class="button secondary" href="/Dashboard/AuditLogs/<%= guild.guildId %>"><i data-lucide="search"></i>Browse history</a><% } %></div><% if (!business) { %><div class="empty compact"><i data-lucide="lock-keyhole"></i><h3>Business plan required</h3><p>Current plan: <%= guild.premiumTier %></p></div><% } else { %><form method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="section" value="logs"><div class="field-grid"><% for (const [key, label] of [['moderationChannelId','Bans, mutes, warnings & timeouts'],['autoModChannelId','Flagged words & links'],['serverChannelId','Server events']]) { %><label class="field"><span><%= label %></span><select name="<%= key %>"><option value="">None</option><% channels.forEach(channel => { %><option value="<%= channel.id %>" <%= guild.auditLogs[key] === channel.id ? 'selected' : '' %>>#<%= channel.name %></option><% }); %></select></label><% } %></div><div class="toggle-grid"><% for (const [key, label] of [['enabled','Audit logging'],['includeMessageContent','Include flagged message content'],['sendServerEventsToDiscord','Send server events to Discord'],['messageEdits','Message edits'],['messageDeletes','Message deletions'],['memberChanges','Member changes'],['voiceChanges','Voice changes'],['serverChanges','Server name changes']]) { %><label class="toggle-row"><span><%= label %></span><input class="switch" type="checkbox" name="<%= key %>" <%= guild.auditLogs[key] ? 'checked' : '' %>></label><% } %></div><div class="form-actions"><button class="button primary"><i data-lucide="save"></i>Save audit settings</button></div></form><% } %></section>
<% } else if (tab === 'levels') { %>
<section class="section"><div class="section-heading"><h2>Leaderboard</h2><span class="muted">Top 100</span></div><% if (!levels.length) { %><div class="empty compact"><i data-lucide="trophy"></i><p>No XP recorded yet.</p></div><% } else { %><div class="table-scroll"><table><thead><tr><th>Rank</th><th>Member</th><th>Level</th><th>XP</th></tr></thead><tbody><% levels.forEach((entry, index) => { %><tr><td><%= index + 1 %></td><td><%= entry.userTag %></td><td><%= entry.level %></td><td><%= entry.xp.toLocaleString() %></td></tr><% }); %></tbody></table></div><% } %></section>
<% } %>
<%- include('partials/foot') %>
