<%- include('partials/head', { title: 'Superadmin' }) %>
<%- include('partials/connection') %>
<section class="page-heading"><div><p class="eyebrow">Owner settings</p><h1>Superadmin</h1></div><span class="badge success">Owner verified</span></section>
<% if (storageMode === 'Local file') { %><div class="notice warning"><i data-lucide="database"></i><span>MySQL is not configured. Local files may be replaced during Hostinger deployments.</span></div><% } %>
<form method="post" class="settings-form"><input type="hidden" name="csrf" value="<%= csrf %>"><section class="section"><div class="section-heading"><h2>Discord application</h2></div><div class="field-grid"><label class="field"><span>Application / client ID <%= envManaged.clientId ? '(environment)' : '' %></span><input name="clientId" value="<%= configured.clientId %>" pattern="[0-9]{17,20}" <%= envManaged.clientId ? 'readonly' : '' %>></label><label class="field"><span>Client secret <%= envManaged.secret ? '(environment)' : '' %></span><input type="password" name="clientSecret" autocomplete="new-password" placeholder="<%= configured.secret ? 'Configured; leave blank to keep' : 'Not configured' %>" <%= envManaged.secret ? 'disabled' : '' %>></label><label class="field"><span>Bot token <%= envManaged.token ? '(environment)' : '' %></span><input type="password" name="botToken" autocomplete="new-password" placeholder="<%= configured.token ? 'Configured; leave blank to keep' : 'Not configured' %>" <%= envManaged.token ? 'disabled' : '' %>></label><label class="field"><span>Superadmin Discord ID</span><input value="<%= user.id %>" readonly></label><label class="field span-2"><span>OAuth redirect URL</span><div class="copy-field"><input id="callback-url" value="<%= callbackUrl %>" readonly><button class="icon-button" type="button" data-copy="callback-url" title="Copy redirect URL" aria-label="Copy redirect URL"><i data-lucide="copy"></i></button></div></label></div><div class="toggle-grid"><label class="toggle-row"><span>Privileged member & message-content intents <%= envManaged.privilegedIntents ? '(environment)' : '' %></span><input class="switch" type="checkbox" name="privilegedIntents" <%= configured.privilegedIntents ? 'checked' : '' %> <%= envManaged.privilegedIntents ? 'disabled' : '' %>></label></div><div class="form-actions"><label class="check"><input type="checkbox" name="restart">Reconnect bot after saving</label><button class="button primary"><i data-lucide="save"></i>Save application settings</button></div></section></form>
<section class="section"><div class="section-heading"><h2>Server plan</h2></div><form method="post" action="/SuperAdmin/plan"><input type="hidden" name="csrf" value="<%= csrf %>"><div class="field-grid"><label class="field"><span>Server</span><select name="guildId" required><% Object.values(guilds).forEach(guild => { %><option value="<%= guild.guildId %>"><%= guild.guildName %> (<%= guild.premiumTier %>)</option><% }); %></select></label><label class="field"><span>Plan</span><select name="tier"><% for (const tier of ['Free','Pro','Business','Enterprise']) { %><option><%= tier %></option><% } %></select></label><label class="field"><span>Expiry (UTC, optional)</span><input type="datetime-local" name="expires"></label></div><div class="form-actions"><button class="button secondary"><i data-lucide="badge-check"></i>Update plan</button></div></form></section>
<section class="section"><div class="section-heading"><h2>Deployment</h2><a href="/service">Service status</a></div><dl class="status-list"><div><dt>Runtime</dt><dd>Node.js</dd></div><div><dt>Database</dt><dd><%= storageMode %></dd></div><div><dt>Version</dt><dd><%= version %></dd></div></dl></section>
<%- include('partials/foot') %>
