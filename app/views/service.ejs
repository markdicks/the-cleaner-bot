<%- include('partials/head', { title: 'Service status' }) %>
<section class="page-heading"><div><p class="eyebrow">Live status</p><h1>The Cleaner service</h1></div><a class="button primary" href="/Dashboard"><i data-lucide="layout-dashboard"></i>Open dashboard</a></section>
<section class="section"><dl class="status-list"><div><dt><i data-lucide="globe"></i>Website</dt><dd class="text-success">Online</dd></div><div><dt><i data-lucide="bot"></i>Discord bot</dt><dd data-service-bot class="<%= status.discord.connected ? 'text-success' : 'text-warning' %>"><%= status.discord.connected ? 'Connected to Discord' : status.discord.errorCode === 'token_missing' ? 'Bot token is not configured' : status.discord.errorCode === 'token_invalid' ? 'Bot token was rejected' : 'Disconnected' %></dd></div><div><dt><i data-lucide="database"></i>Dashboard storage</dt><dd><%= storageStatus === 'ready' ? 'Available' : storageStatus === 'starting' ? 'Starting' : 'Unavailable' %></dd></div><div><dt>Application version</dt><dd><%= version %></dd></div><div><dt>Uptime</dt><dd data-service-uptime><%= Math.floor(status.uptimeSeconds / 60) %> minutes</dd></div></dl><p class="muted status-refresh" data-service-refresh>Live status</p></section>
<%- include('partials/foot') %>
