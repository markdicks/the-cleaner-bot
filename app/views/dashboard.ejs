<%- include('partials/head', { title: 'Your servers' }) %>
<%- include('partials/connection', { compact: true }) %>
<section class="page-heading"><div><h1>Your servers</h1><p class="muted"><%= guilds.length %> available</p></div><% if (inviteUrl) { %><a class="button primary" href="<%= inviteUrl %>" target="_blank" rel="noopener noreferrer"><i data-lucide="plus"></i>Add bot to server</a><% } %></section>
<% if (storageMode === 'Local file' && superAdmin) { %><div class="notice warning"><i data-lucide="database"></i><span>Local storage is active. Configure MySQL before redeploying to retain settings and history.</span></div><% } %>
<section class="section"><div class="filter-bar"><label class="search-field server-search"><i data-lucide="search"></i><input type="search" aria-label="Search servers" placeholder="Search servers" data-filter-list="server-list"></label></div>
<% if (!guilds.length) { %><div class="empty"><i data-lucide="server"></i><h2>No servers available</h2><% if (inviteUrl) { %><a class="button primary" href="<%= inviteUrl %>" target="_blank" rel="noopener noreferrer">Add bot to server</a><% } %></div>
<% } else { %><div class="server-grid" id="server-list"><% for (const server of guilds) { %><article class="server-card" data-filter-item="<%= server.name.toLowerCase() %>"><div class="server-identity"><% if (server.iconUrl) { %><img src="<%= server.iconUrl %>" width="48" height="48" alt=""><% } else { %><span class="server-initial"><%= server.name.slice(0, 1).toUpperCase() %></span><% } %><div><h2><%= server.name %></h2><span class="muted"><%= server.memberCount.toLocaleString() %> members</span></div></div><div class="server-meta"><span class="badge"><%= server.premiumTier %></span><span class="muted">AutoMod <%= server.enableModeration ? 'on' : 'off' %></span></div><a class="button secondary full" href="<%= serverUrl(server.id) %>"><i data-lucide="settings-2"></i>Manage server</a></article><% } %><div class="empty compact" data-list-empty hidden><i data-lucide="search"></i><p>No matching servers.</p></div></div><% } %></section>
<%- include('partials/foot') %>
