<%- include('partials/head', { title: 'Dashboard' }) %>
<section class="page-heading"><div><p class="eyebrow">Workspace</p><h1>Your servers</h1></div><% if (inviteUrl) { %><a class="button primary" href="<%= inviteUrl %>" target="_blank" rel="noopener noreferrer"><i data-lucide="plus"></i>Add bot to server</a><% } %></section>
<div class="metrics"><div><span>Bot connection</span><strong class="<%= status.discord.connected ? 'text-success' : 'text-warning' %>"><%= status.discord.connected ? 'Online' : 'Offline' %></strong></div><div><span>Manageable servers</span><strong><%= guilds.length %></strong></div><div><span>Moderation cases</span><strong><%= cases.length ? 'Active history' : 'No cases yet' %></strong></div><div><span>Storage</span><strong><%= storageMode %></strong></div></div>
<% if (!contentAccess) { %><div class="notice warning"><i data-lucide="triangle-alert"></i><span>Message-content filters are inactive. Privileged intents are not enabled for this connection.</span><% if (superAdmin) { %><a href="/SuperAdmin">Settings</a><% } %></div><% } %>
<% if (storageMode === 'Local file' && superAdmin) { %><div class="notice warning"><i data-lucide="database"></i><span>Local storage is active. Configure MySQL before redeploying to retain settings and history.</span></div><% } %>
<section class="section"><div class="section-heading"><h2>Servers</h2><span class="muted"><%= guilds.length %> available</span></div>
<% if (!guilds.length) { %><div class="empty"><i data-lucide="server"></i><h3>No servers available</h3><p>Only servers you can manage are shown.</p><% if (inviteUrl) { %><a class="button primary" href="<%= inviteUrl %>" target="_blank" rel="noopener noreferrer">Add bot to server</a><% } %></div>
<% } else { %><div class="server-grid"><% guilds.forEach(guild => { %><article class="server-card"><div class="server-identity"><% if (guild.iconUrl) { %><img src="<%= guild.iconUrl %>" width="48" height="48" alt=""><% } else { %><span class="server-initial"><%= guild.name.slice(0, 1).toUpperCase() %></span><% } %><div><h3><%= guild.name %></h3><span class="muted"><%= guild.memberCount.toLocaleString() %> members</span></div></div><div class="server-meta"><span class="badge"><%= guild.premiumTier %></span><span class="muted">Moderation <%= guild.enableModeration ? 'on' : 'off' %></span></div><a class="button secondary full" href="/Dashboard/Guild/<%= guild.id %>"><i data-lucide="settings-2"></i>Manage server</a></article><% }); %></div><% } %></section>
<section class="section"><div class="section-heading"><h2>Recent moderation</h2></div><%- include('partials/cases', { cases }) %></section>
<%- include('partials/foot') %>
