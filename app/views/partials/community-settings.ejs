<% if (tab === 'levels' && view === 'leaderboard') { %><section class="section"><div class="section-heading"><h2>Leaderboard</h2><span class="muted">Top 100</span></div><% if (!levels.length) { %><div class="empty compact"><i data-lucide="trophy"></i><p>No XP recorded yet.</p></div><% } else { %><div class="table-scroll"><table><thead><tr><th>Rank</th><th>Member</th><th>Level</th><th>XP</th></tr></thead><tbody><% levels.forEach((entry, index) => { %><tr><td><%= index + 1 %></td><td><%= entry.userTag %></td><td><%= entry.level %></td><td><%= entry.xp.toLocaleString() %></td></tr><% }); %></tbody></table></div><% } %></section>
<% } else { %><form method="post" data-settings-form><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="section" value="<%= tab === 'levels' ? 'levelSettings' : tab === 'welcome' ? 'welcome' : 'general' %>">
<% if (tab === 'levels') { %><section class="section"><div class="section-heading"><h2>Experience & announcements</h2></div><div class="toggle-grid"><% for (const [key, label] of [['enableLevels','Chat XP & levels'],['enableVoiceXp','Voice XP']]) { %><label class="toggle-row"><span><%= label %></span><input class="switch" type="checkbox" name="<%= key %>" <%= guild[key] ? 'checked' : '' %>></label><% } %></div><div class="field-grid section-fields"><%- include('channel-field', { name: 'levelsChannelId', label: 'Level announcement channel', value: guild.levelsChannelId, fieldId: 'levels-channel' }) %></div></section>
<% } else if (tab === 'welcome') { %><section class="section"><label class="toggle-row module-toggle"><span>Welcome & goodbye messages</span><input class="switch" type="checkbox" name="enableWelcome" <%= guild.enableWelcome ? 'checked' : '' %>></label><div class="field-grid section-fields"><%- include('channel-field', { name: 'welcomeChannelId', label: 'Announcement channel', value: guild.welcomeChannelId }) %></div></section><section class="section"><div class="section-heading"><h2>Member messages</h2></div><div class="field-grid"><label class="field"><span>Welcome message</span><textarea name="welcomeMessage" rows="5" maxlength="1900"><%= guild.welcomeMessage %></textarea></label><label class="field"><span>Goodbye message</span><textarea name="goodbyeMessage" rows="5" maxlength="1900"><%= guild.goodbyeMessage %></textarea></label></div></section>
<% } else { %><section class="section"><div class="section-heading"><h2>General</h2></div><div class="field-grid"><label class="field" id="command-prefix"><span>Command prefix</span><input name="prefix" value="<%= guild.prefix %>" maxlength="10" required></label><%- include('channel-field', { name: 'logChannelId', label: 'Fallback moderation log channel', value: guild.logChannelId, fieldId: 'fallback-channel' }) %></div></section><section class="section"><div class="section-heading"><h2>Server</h2></div><dl class="status-list"><div><dt>Server ID</dt><dd class="mono"><%= guild.guildId %></dd></div><div><dt>Plan</dt><dd><%= guild.premiumTier %></dd></div><div><dt>Updated</dt><dd><%= new Date(guild.updatedAt).toLocaleString('en-GB', { timeZone: 'UTC' }) %> UTC</dd></div></dl></section><% } %>
<%- include('save-bar') %></form><% } %>
