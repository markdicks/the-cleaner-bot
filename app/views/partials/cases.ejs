<% if (!cases.length) { %><div class="empty compact"><i data-lucide="shield-check"></i><p>No moderation cases recorded.</p></div><% } else { %><div class="table-scroll"><table><thead><tr><th>Case</th><th>Action</th><th>Member</th><th>Reason</th><th>Date</th></tr></thead><tbody><% cases.forEach(entry => { %><tr><td class="mono">#<%= entry.id %></td><td><span class="badge <%= ['ban','kick','timeout'].includes(entry.action) ? 'warning' : '' %>"><%= entry.action %></span></td><td><%= entry.targetUserTag || entry.targetUserId || '—' %></td><td class="wrap"><%= entry.reason %></td><td class="nowrap"><time datetime="<%= entry.createdAt %>"><%= new Date(entry.createdAt).toLocaleString('en-GB', { timeZone: 'UTC', dateStyle: 'medium', timeStyle: 'short' }) %> UTC</time></td></tr><% }); %></tbody></table></div><% } %>
