<% if (!cases.length) { %><div class="empty compact"><i data-lucide="shield-check"></i><p>No matching punishment cases.</p></div><% } else { %><div class="table-scroll"><table class="case-table"><thead><tr><th>Case</th><th>Member</th><th>Action</th><th>Moderator</th><th>Reason</th><th>Date</th></tr></thead><tbody><% for (const entry of cases) { %><tr><td data-label="Case" class="mono">#<%= entry.id %></td><td data-label="Member"><% if (guild && entry.targetUserId) { %><a href="<%= serverUrl(guild.guildId, 'cases') %>&q=<%= encodeURIComponent(entry.targetUserId) %>"><%= entry.targetUserTag || entry.targetUserId %></a><% } else { %><%= entry.targetUserTag || entry.targetUserId || 'Not recorded' %><% } %><% if (entry.targetUserTag && entry.targetUserId) { %><small class="table-id"><%= entry.targetUserId %></small><% } %></td><td data-label="Action"><span class="badge <%= ['ban','kick','timeout'].includes(String(entry.action).toLowerCase()) ? 'warning' : '' %>"><%= entry.action %></span></td><td data-label="Moderator" class="mono"><%= entry.moderatorUserId || 'Not recorded' %></td><td data-label="Reason" class="wrap"><%= entry.reason || 'No reason recorded' %></td><td data-label="Date"><time datetime="<%= entry.createdAt %>"><%= Number.isFinite(Date.parse(entry.createdAt)) ? new Date(entry.createdAt).toLocaleString('en-GB', { timeZone: 'UTC', dateStyle: 'medium', timeStyle: 'short' }) + ' UTC' : 'Not recorded' %></time></td></tr><% } %></tbody></table></div><% } %>
