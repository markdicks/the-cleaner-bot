<label class="field" id="<%= typeof fieldId === 'string' ? fieldId : name + '-field' %>"><span><%= label %></span><select name="<%= name %>"><option value="">None</option><% if (value && !channels.some(channel => channel.id === value)) { %><option value="<%= value %>" selected>Unavailable channel (<%= value %>)</option><% } %><% for (const channel of channels) { %><option value="<%= channel.id %>" <%= value === channel.id ? 'selected' : '' %>>#<%= channel.name %></option><% } %></select></label>
