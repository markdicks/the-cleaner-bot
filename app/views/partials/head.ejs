<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> | The Cleaner</title>
    <link rel="icon" href="/assets/mark.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/assets/app.css?v=<%= version %>">
    <link rel="stylesheet" href="/assets/diagnostics.css?v=<%= version %>">
    <script src="/assets/lucide.js?v=<%= version %>" defer></script>
    <script src="/assets/app.js?v=<%= version %>" defer></script>
</head>
<body>
<aside class="sidebar" id="navigation">
    <a class="brand" href="/Dashboard"><img src="/assets/mark.svg" width="34" height="34" alt=""><span>The Cleaner<small>Control center</small></span></a>
    <nav aria-label="Main navigation">
        <a class="nav-link <%= path.startsWith('/Dashboard') ? 'active' : '' %>" href="/Dashboard"><i data-lucide="layout-dashboard"></i>Dashboard</a>
        <% if (superAdmin) { %><a class="nav-link <%= path === '/SuperAdmin' ? 'active' : '' %>" href="/SuperAdmin"><i data-lucide="shield-check"></i>Superadmin</a><% } %>
        <a class="nav-link <%= ['/service','/Service','/status'].includes(path) ? 'active' : '' %>" href="/service"><i data-lucide="activity"></i>Service status</a>
    </nav>
    <div class="sidebar-bottom"><span data-bot-status class="badge <%= status.discord.connected ? 'success' : 'warning' %>"><%= status.discord.connected ? 'Bot online' : 'Bot offline' %></span><small>Version <%= version %></small></div>
</aside>
<div class="workspace">
    <header class="topbar">
        <button class="icon-button mobile-menu" type="button" id="menu-toggle" title="Toggle navigation" aria-label="Toggle navigation" aria-controls="navigation" aria-expanded="false"><i data-lucide="menu"></i></button>
        <span class="breadcrumb">The Cleaner <span>/</span> <%= title %></span>
        <div class="account">
            <% if (user) { %>
                <% if (user.avatar) { %><img class="avatar" src="<%= user.avatar %>" alt=""><% } %><span><%= user.name %></span>
                <form method="post" action="/Auth/Logout"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="icon-button" title="Sign out" aria-label="Sign out"><i data-lucide="log-out"></i></button></form>
            <% } else { %><a class="quiet-link" href="/Auth/Login">Sign in</a><% } %>
        </div>
    </header>
    <main>
    <% if (message) { %><div class="notice" role="status"><i data-lucide="info"></i><span><%= message %></span><button type="button" class="icon-button dismiss-notice" title="Dismiss" aria-label="Dismiss"><i data-lucide="x"></i></button></div><% } %>
