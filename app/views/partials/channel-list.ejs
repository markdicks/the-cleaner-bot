<div class="selection-tools"><label class="search-field"><i data-lucide="search"></i><input type="search" placeholder="Search channels" aria-label="Search <%= label %>" data-filter-list="<%= listId %>"></label><output data-selection-count="<%= listId %>"><%= selected.length %> selected</output><button type="button" class="icon-button" data-select-visible="<%= listId %>" title="Select visible channels" aria-label="Select visible channels"><i data-lucide="list-checks"></i></button><button type="button" class="icon-button" data-clear-list="<%= listId %>" title="Clear selection" aria-label="Clear selection"><i data-lucide="square"></i></button></div>
<div class="checkbox-grid channel-checklist" id="<%= listId %>"><% for (const channel of channels) { %><label class="check" data-filter-item="<%= channel.name.toLowerCase() %>"><input type="checkbox" name="<%= name %>" value="<%= channel.id %>" <%= selected.includes(channel.id) ? 'checked' : '' %>>#<%= channel.name %></label><% } %><% if (!channels.length) { %><p class="muted">Channels unavailable while disconnected.</p><% } %><p class="muted" data-list-empty hidden>No matching channels.</p></div>
