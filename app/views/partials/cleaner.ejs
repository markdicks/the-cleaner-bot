<form method="post" data-settings-form><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="section" value="cleaner"><section class="section"><div class="section-heading"><h2>Schedule & delivery</h2></div><div class="field-grid"><label class="field"><span>Cleaning interval (minutes)</span><input type="number" name="intervalMinutes" min="1" max="120960" value="<%= guild.cleaner.intervalMinutes %>" required></label><%- include('channel-field', { name: 'cleanerLogChannelId', label: 'Cleaning log channel', value: guild.cleaner.logChannelId }) %></div></section>
<section class="section"><div class="section-heading"><h2>Monitored channels</h2></div><%- include('channel-list', { name: 'monitorChannels', selected: guild.cleaner.monitorChannels, listId: 'cleaning-channel-list', label: 'monitored channels' }) %></section>
<section class="section" id="cleaning-targets"><div class="section-heading"><h2>Cleaning targets</h2><button class="button secondary" type="button" data-add-target><i data-lucide="plus"></i>Add bot</button></div><div data-target-list><% for (const bot of guild.cleaner.botList) { %><div class="target-row" data-target-row><label class="field"><span>Bot ID</span><input name="botIds" value="<%= bot.botId %>" inputmode="numeric" pattern="[0-9]{17,20}" required></label><label class="field"><span>Rounds</span><input name="botRounds" type="number" value="<%= bot.rounds %>" min="-1" max="10000" required></label><label class="check"><input type="checkbox" data-permanent <%= bot.rounds === -1 ? 'checked' : '' %>>Permanent</label><button class="icon-button" type="button" data-remove-target aria-label="Remove cleaning target" title="Remove cleaning target"><i data-lucide="trash-2"></i></button></div><% } %></div><p class="muted" data-target-empty <%= guild.cleaner.botList.length ? 'hidden' : '' %>>No bots configured.</p>
<template id="cleaning-target-template"><div class="target-row" data-target-row><label class="field"><span>Bot ID</span><input name="botIds" inputmode="numeric" pattern="[0-9]{17,20}" required></label><label class="field"><span>Rounds</span><input name="botRounds" type="number" value="1" min="-1" max="10000" required></label><label class="check"><input type="checkbox" data-permanent>Permanent</label><button class="icon-button" type="button" data-remove-target aria-label="Remove cleaning target" title="Remove cleaning target"><i data-lucide="trash-2"></i></button></div></template>
<noscript><label class="field"><span>Bot IDs & rounds</span><textarea name="botList" rows="6"><%= guild.cleaner.botList.map(bot => `${bot.botId} ${bot.rounds}`).join('\n') %></textarea></label></noscript></section><%- include('save-bar') %></form>
