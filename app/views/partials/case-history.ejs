<form method="get" class="filter-bar history-filters"><input type="hidden" name="tab" value="cases"><label class="field"><span>Search history</span><input type="search" name="q" value="<%= query %>" placeholder="User, moderator, reason or case ID"></label><label class="field"><span>Action</span><select name="action"><option value="">All actions</option><% for (const [key, label] of [['warn','Warning'],['timeout','Timeout'],['untimeout','Timeout removed'],['mute','Mute'],['unmute','Mute removed'],['kick','Kick'],['ban','Ban'],['unban','Unban']]) { %><option value="<%= key %>" <%= actionFilter === key ? 'selected' : '' %>><%= label %></option><% } %></select></label><button class="button secondary"><i data-lucide="search"></i>Search</button><a class="icon-button" href="<%= serverUrl(guild.guildId, 'cases') %>" title="Clear filters" aria-label="Clear filters"><i data-lucide="rotate-ccw"></i></a></form>
<section class="section"><div class="section-heading"><h2>Recorded punishments <span class="count-label"><%= caseCount %></span></h2><a class="button secondary" href="?<%= new URLSearchParams({ tab: 'cases', q: query, action: actionFilter, format: 'csv' }) %>"><i data-lucide="download"></i>Export CSV</a></div><%- include('cases') %>
<div class="pagination"><span class="muted">Page <%= casePage %> of <%= pageCount %></span><div class="button-row"><% for (const [page, label, disabled] of [[casePage - 1, 'Previous', casePage <= 1], [casePage + 1, 'Next', casePage >= pageCount]]) { %><% if (disabled) { %><button type="button" class="button secondary" disabled><%= label %></button><% } else { %><a class="button secondary" href="?<%= new URLSearchParams({ tab: 'cases', q: query, action: actionFilter, page }) %>"><%= label %></a><% } %><% } %></div></div></section>
