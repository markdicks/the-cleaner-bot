<% if (view === 'settings') { %>
<form method="post" data-settings-form><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="section" value="moderationOptions"><section class="section"><div class="section-heading"><h2>Warnings & timeouts</h2><a href="<%= serverUrl(guild.guildId, 'logs', 'channels', 'moderation-channel') %>">Moderation log channel</a></div><div class="field-grid"><label class="field"><span>Warnings before automatic timeout</span><input type="number" name="maxWarningsBeforeTimeout" min="1" max="100" value="<%= guild.maxWarningsBeforeTimeout %>" required></label><label class="field"><span>Default timeout (minutes)</span><input type="number" name="timeoutMinutes" min="1" max="40320" value="<%= guild.timeoutMinutes %>" required></label></div><label class="toggle-row"><span>Private moderation notices</span><input class="switch" type="checkbox" name="enableDmModerationNotices" <%= guild.enableDmModerationNotices ? 'checked' : '' %>></label></section><%- include('save-bar') %></form>
<% } else { %>
<form method="post" action="/Dashboard/Guild/<%= guild.guildId %>/action" class="action-form"><input type="hidden" name="csrf" value="<%= csrf %>">
<section class="section"><div class="section-heading"><h2><%= view === 'purge' ? 'Purge messages' : 'Member action' %></h2></div><div class="field-grid">
<% if (view === 'purge') { %><input type="hidden" name="action" value="purge"><label class="field"><span>Channel</span><select name="channelId" required><option value="">Select channel</option><% for (const channel of channels) { %><option value="<%= channel.id %>">#<%= channel.name %></option><% } %></select></label><label class="field"><span>Messages to inspect</span><input type="number" name="count" min="1" max="1000" value="100" required></label><label class="field"><span>User ID (optional)</span><input name="userId" inputmode="numeric" pattern="[0-9]{17,20}"></label><label class="field"><span>Role (optional)</span><select name="roleId"><option value="">All roles</option><% for (const role of roles) { %><option value="<%= role.id %>"><%= role.name %></option><% } %></select></label><label class="field"><span>Text contains (optional)</span><input name="contains" maxlength="200"></label><label class="check"><input type="checkbox" name="bots">Only bot messages</label>
<% } else { %><label class="field"><span>Action</span><select name="action" data-member-action><option value="warn">Warning</option><option value="timeout">Timeout / mute</option><option value="untimeout">Remove timeout</option><option value="kick">Kick</option><option value="ban">Ban</option><option value="unban">Unban</option></select></label><label class="field"><span>Discord user ID</span><input name="userId" value="<%= selectedUser %>" inputmode="numeric" pattern="[0-9]{17,20}" required></label><label class="field" data-timeout-field><span>Timeout duration (minutes)</span><input type="number" name="minutes" min="1" max="40320" value="<%= guild.timeoutMinutes %>"></label><label class="field span-2"><span>Reason</span><textarea name="reason" rows="3" maxlength="500" required></textarea></label><% } %>
</div><div class="action-confirmation"><label class="check"><input type="checkbox" name="confirm" required><%= view === 'purge' ? 'Confirm permanent message deletion' : 'Confirm member action' %></label><button class="button danger" type="submit"><i data-lucide="<%= view === 'purge' ? 'trash-2' : 'gavel' %>"></i><span data-action-label><%= view === 'purge' ? 'Purge matching messages' : 'Issue warning' %></span></button></div></section></form><% } %>
