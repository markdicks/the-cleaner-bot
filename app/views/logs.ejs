<%- include('partials/head', { title: 'Activity' }) %>
<section class="page-heading"><div><a class="server-context" href="<%= serverUrl(guild.guildId) %>"><%= guild.guildName %></a><h1>Activity</h1></div><div class="button-row"><a class="button secondary" href="<%= serverUrl(guild.guildId, 'logs') %>"><i data-lucide="settings-2"></i>Configure logs</a><a class="button secondary" href="?format=csv&q=<%= encodeURIComponent(query) %>&category=<%= category %>"><i data-lucide="download"></i>Export CSV</a></div></section>
<form method="get" class="filter-bar"><label class="field"><span>Search</span><input type="search" name="q" value="<%= query %>" placeholder="Message, member ID or event"></label><label class="field"><span>Category</span><select name="category"><option value="">All categories</option><% for (const value of ['moderation','automod','server']) { %><option value="<%= value %>" <%= category === value ? 'selected' : '' %>><%= value %></option><% } %></select></label><button class="button secondary"><i data-lucide="search"></i>Search</button></form>
<section class="section"><div class="section-heading"><h2>History</h2><span class="muted">30-day retention</span></div><% if (!entries.length) { %><div class="empty compact"><i data-lucide="scroll-text"></i><p>No matching events.</p></div><% } else { %><div class="audit-list"><% entries.forEach(entry => { %><article class="audit-entry"><div><span class="badge"><%= entry.category %></span><time class="muted" datetime="<%= entry.createdAt %>"><%= new Date(entry.createdAt).toLocaleString('en-GB', { timeZone: 'UTC' }) %> UTC</time></div><h3><%= entry.title %></h3>
    <% const display = entry.presentation; %>
    <p class="message-content"><%= display?.description ?? entry.details %></p>
    <% for (const field of display?.fields || []) { %><h4><%= field.name %></h4><p class="message-content"><% if (field.segments?.length) { for (const part of field.segments) { if (part.changed) { %><u class="edit-change"><%= part.display ?? part.text %></u><% } else { %><%= part.text %><% } } } else { %><%= field.value %><% } %></p><% } %>
    <% if (display?.footer) { %><small class="muted message-content"><%= display.footer %></small><% } %>
    <% if (/^https:\/\/discord\.com\/channels\/\d{17,20}\/\d{17,20}(?:\/\d{17,20})?$/.test(display?.jumpUrl || '')) { %><p><a href="<%= display.jumpUrl %>" target="_blank" rel="noopener noreferrer"><%= display.jumpLabel || 'Jump to Message' %></a></p><% } %>
</article><% }); %></div><% } %></section>
<%- include('partials/foot') %>
